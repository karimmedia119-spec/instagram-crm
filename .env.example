# ==============================================================================
# INSTAGRAM CRM - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Database Connection (SQLite for local, PostgreSQL for cloud deployment)
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production Cloud Example (Supabase / Neon / Railway PostgreSQL):
# DATABASE_URL="postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres?schema=public"

# 2. Authentication & JWT Security
JWT_SECRET="replace_with_a_long_random_secure_secret_key_for_production"

# 3. Application Public Domain (for Webhook callbacks)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# 4. Meta Instagram Graph API Webhook Credentials
META_VERIFY_TOKEN="ig_crm_secret_token_2026"
META_APP_SECRET="your_meta_app_secret_here"
INSTAGRAM_BUSINESS_ACCOUNT_ID="17841400000000001"
PAGE_ACCESS_TOKEN="EAAK..."

# 5. SMTP Mailer Configuration (For sending password reset codes)
# Target reset email: karim.media.119@gmail.com
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
RESET_NOTIFICATION_EMAIL="karim.media.119@gmail.com"
